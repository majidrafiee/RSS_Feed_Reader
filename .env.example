# Telegram Bot API token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# API credentials from https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# StringSession generated locally with: python scripts/gen_session.py
SESSION_STRING=your_long_session_string_here

# Postgres connection string (Northflank addon provides this)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: how often to poll RSS feeds, in seconds (default 300)
RSS_POLL_SECONDS=300

# Optional: directory for the rotating log file (default: data)
# Make this a persistent volume on Northflank so logs survive redeploy.
LOG_DIR=data

# Optional: max log file size before rotation, in bytes (default 5242880 = 5 MB)
LOG_MAX_BYTES=5242880

# Optional: number of rotated log files to keep (default 1)
# Total log ceiling = LOG_MAX_BYTES × (LOG_BACKUP_COUNT + 1)
LOG_BACKUP_COUNT=1

# Optional: root log level — DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO
